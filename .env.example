# Required
DATABASE_URL=postgresql://printing:printing@localhost:5432/printing
NODE_ENV=development

# Backend API port (default 3000)
PORT=3000

# Admin: set to enable admin API and UI (Bearer admin:<value>)
# ADMIN_SECRET=

# Optional: payment providers (only when methods are enabled in admin)
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=

# Optional: connector integration (admin/backend only)
# CONNECTOR_API_URL=http://localhost:4100
# CONNECTOR_API_KEY=
# CONNECTOR_WEBHOOK_SECRET=

# Optional: Redis for cache and rate limiting (backend runs without cache/rate limit if unset)
# REDIS_URL=redis://localhost:6379

# Frontend: API base URL when calling backend (default for local dev)
# NEXT_PUBLIC_API_BASE=http://localhost:3000/api/v1
