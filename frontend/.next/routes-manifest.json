{
  "version": 3,
  "pages404": true,
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [
    {
      "page": "/admin/orders/[id]",
      "regex": "^/admin/orders/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/admin/orders/(?<nxtPid>[^/]+?)(?:/)?$"
    },
    {
      "page": "/admin/queues/[id]",
      "regex": "^/admin/queues/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/admin/queues/(?<nxtPid>[^/]+?)(?:/)?$"
    },
    {
      "page": "/orders/[orderId]",
      "regex": "^/orders/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPorderId": "nxtPorderId"
      },
      "namedRegex": "^/orders/(?<nxtPorderId>[^/]+?)(?:/)?$"
    }
  ],
  "staticRoutes": [
    {
